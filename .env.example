# Application
APP_NAME=KasirPro
APP_ENV=development
PORT=8080
APP_URL=https://fish-warming-logos-lots.trycloudflare.com
CORS_ALLOWED_ORIGINS=https://fish-warming-logos-lots.trycloudflare.com,http://localhost:5173,http://localhost:3000,http://localhost

# Database (Root user for migrations/admin)
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=kasirpro

# Application Database User (Least Privilege)
APP_DB_USER=kasirpro_app
APP_DB_PASSWORD=kasirpro_secret_password

# JWT Security
JWT_SECRET=super_secret_jwt_key_kasirpro_256bit_minimum_length_required!
JWT_ACCESS_EXPIRE_MINUTES=1440
JWT_REFRESH_EXPIRE_DAYS=7

# Midtrans Payment Gateway (Simulator / Sandbox)
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_SANDBOX_SERVER_KEY
MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_SANDBOX_CLIENT_KEY
MIDTRANS_IS_PRODUCTION=false

# Store Default Config
DEFAULT_TAX_RATE=11
DEFAULT_CURRENCY=IDR
STORE_NAME=KasirPro Store
STORE_ADDRESS=Jl. Sudirman No. 123, Jakarta
STORE_PHONE=081234567890

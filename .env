# Application
APP_NAME=KasirPro
APP_ENV=development
PORT=8080
APP_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# Database (For local Docker or direct local execution)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=kasirpro

# Application Database User (Least Privilege)
APP_DB_USER=kasirpro_app
APP_DB_PASSWORD=kasirpro_secret_password

# JWT Security
JWT_SECRET=super_secret_jwt_key_kasirpro_256bit_minimum_length_required!
JWT_ACCESS_EXPIRE_MINUTES=1440
JWT_REFRESH_EXPIRE_DAYS=7

# Midtrans Payment Gateway (Simulator / Sandbox)
MIDTRANS_SERVER_KEY=SB-Mid-server-simulator-mock-key-12345
MIDTRANS_CLIENT_KEY=SB-Mid-client-simulator-mock-key-12345
MIDTRANS_IS_PRODUCTION=false

# Store Default Config
DEFAULT_TAX_RATE=11
DEFAULT_CURRENCY=IDR
STORE_NAME=KasirPro Modern Market
STORE_ADDRESS=Jl. Kinibalu Timur No.402, Jawa Tengah, Indonesia 
STORE_PHONE=0895366900501
